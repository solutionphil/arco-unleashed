# Katapult bootloader configuration for the Phrozen Arco toolhead (MKS_THR, STM32F103).
#
# Deployed by scripts/install-katapult.sh so its `make menuconfig` never has to open. The six answers
# that screen asks for are all here, and asking an owner to retype them is six chances to mistype in a
# step whose mistakes only surface two builds later as "Error sending CONNECT".
#
# The menu labels map to these symbols:
#   Processor model .......... STM32F103          -> CONFIG_MACH_STM32F103
#   Clock Reference .......... 8 MHz crystal      -> CONFIG_STM32_CLOCK_REF_8M
#   Application start offset . 8KiB               -> CONFIG_STM32_APP_START_2000
#   Communication interface .. USART1 PA10/PA9    -> CONFIG_STM32_SERIAL_USART1
#   Baud rate ................ 250000             -> CONFIG_SERIAL_BAUD
#
# CONFIG_FLASH_APPLICATION_ADDRESS is 0x8000000 and that is CORRECT: it is where KATAPULT itself is
# written. The 8 KiB offset the menu asks about is the address Katapult LAUNCHES, which is
# CONFIG_LAUNCH_APP_ADDRESS=0x8002000 and is what flash_mcus.sh builds Klipper for. Reading the first
# symbol as the app offset is the obvious mistake and would condemn a perfectly good configuration.
#
# Captured from a working build of Katapult v0.0.1-113-gec59b9b. If a future Katapult renames a symbol,
# install-katapult.sh notices the mismatch and falls back to the menu rather than building something
# wrong quietly.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_BOARD_DIRECTORY="stm32"
CONFIG_MCU="stm32f103xe"
CONFIG_CLOCK_FREQ=72000000
CONFIG_FLASH_SIZE=0x10000
CONFIG_FLASH_BOOT_ADDRESS=0x8000000
CONFIG_RAM_START=0x20000000
CONFIG_RAM_SIZE=0x5000
CONFIG_STACK_SIZE=512
CONFIG_FLASH_APPLICATION_ADDRESS=0x8000000
CONFIG_FLASH_START=0x8000000
CONFIG_LAUNCH_APP_ADDRESS=0x8002000
CONFIG_BLOCK_SIZE=64
CONFIG_STM32_SELECT=y
CONFIG_MACH_STM32F103=y
CONFIG_MACH_STM32F1=y
CONFIG_HAVE_STM32_USBFS=y
CONFIG_HAVE_STM32_CANBUS=y
CONFIG_STM32_DFU_ROM_ADDRESS=0
CONFIG_STM32_FLASH_START_0000=y
CONFIG_STM32_CLOCK_REF_8M=y
CONFIG_CLOCK_REF_FREQ=8000000
CONFIG_STM32F0_TRIM=16
CONFIG_STM32_SERIAL_USART1=y
CONFIG_STM32_APP_START_2000=y
CONFIG_SERIAL=y
CONFIG_SERIAL_BAUD=250000
CONFIG_USB_VENDOR_ID=0x1d50
CONFIG_USB_DEVICE_ID=0x6177
CONFIG_USB_SERIAL_NUMBER="12345"
CONFIG_CANBUS_FREQUENCY=1000000
CONFIG_HAVE_OPTIMIZE_OS=y
CONFIG_OPTIMIZE_FLAG="-Os"
CONFIG_INITIAL_PINS=""
CONFIG_ENABLE_DOUBLE_RESET=y
CONFIG_HAVE_CHIPID=y
