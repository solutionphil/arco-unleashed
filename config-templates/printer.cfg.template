[pause_resume]

[display_status]

[adxl345]
cs_pin: MKS_THR:PA4
spi_bus: spi1
axes_map: -x, z, -y
rate: 800

[temperature_sensor host]
sensor_type: temperature_host
min_temp: 0
max_temp: 95

[resonance_tester]
accel_chip: adxl345
probe_points:
    150, 150, 20 


[phrozen_dev]
dev_port: /dev/ttyACM1
# auto_connect is deliberately absent. The module defaults it to off, and the value it reads
# is assigned to a variable that nothing acts on (its only use in dev.py is commented out) --
# so setting it either way changed nothing. It used to be flipped when the AMS was switched
# on by hand, which is how it survived that long without anyone noticing.
fila_cut_x_pos: 319
fila_cut_x_pos_up: 1
fila_cut_y_pos: 260
fila_exist_value: 0.476252
fila_empty_value: 0.249695
fila_sensor_pin: MKS_THR:PA2
wait_max_velocity: 180          
wait_line_width: 0.5            
wait_timeout: 60                
switch_fila_zup_by_gcode: 0

