# Everything text defaults to LF (the target is Linux; CRLF breaks bash/systemd).
# Binaries are pinned explicitly below so this catch-all never touches them.
*           text=auto eol=lf

# Explicit text (belt-and-suspenders — scripts & config run on Linux)
*.sh        text eol=lf
*.py        text eol=lf
*.c         text eol=lf
*.h         text eol=lf
*.cfg       text eol=lf
*.conf      text eol=lf
*.template  text eol=lf
*.txt       text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.rules     text eol=lf
*.theme     text eol=lf
*.json      text eol=lf

# Binary artifacts — never touch (last wins, so these override the catch-all)
*.dtb       binary
*.bin       binary
*.clm_blob  binary
*.img       binary
*.gz        binary
*.xz        binary
*.tar       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
