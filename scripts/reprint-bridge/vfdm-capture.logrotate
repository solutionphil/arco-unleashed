# /etc/logrotate.d/arco-vfdm-capture
# voronFDM's stdout is redirected to this file (for the reprint bridge). Cap it.
# copytruncate: truncate in place so voronFDM's already-open fd keeps writing, and
# the bridge's tail (which handles size-shrink) keeps following.
/home/mks/vfdm-capture.log {
    size 20M
    rotate 2
    missingok
    notifempty
    copytruncate
    compress
    su mks mks
}
